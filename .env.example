# ECG Backend API Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Authentication (Optional)
# ============================================
# If set, clients must include "Authorization: Bearer <API_KEY>" header
# If not set, authentication is disabled
API_KEY=

# ============================================
# OpenAI Integration (Optional)
# ============================================
# For AI-generated narrative summaries of ECG analysis
# If not set, narratives will use template-based generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ============================================
# Server Configuration
# ============================================
# Port for local development (production platforms set this automatically)
PORT=8000
